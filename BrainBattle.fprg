<?xml version="1.0" encoding="UTF-8"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="BrainBattle"/>
        <attribute name="authors" value=""/>
        <attribute name="about" value="Brain Battle: Answer three simple math questions and earn points."/>
        <attribute name="saved" value="2026-10-12 10:00:00 am"/>
        <attribute name="created" value="20261012100000000"/>
        <attribute name="edited" value="20261012100000000"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="answer1" type="Integer" array="False" size=""/>
            <declare name="answer2" type="Integer" array="False" size=""/>
            <declare name="answer3" type="Integer" array="False" size=""/>
            <declare name="score" type="Integer" array="False" size=""/>
            <assign variable="score" expression="0"/>
            <output expression="&quot;================================&quot;" newline="True"/>
            <output expression="&quot;          BRAIN BATTLE          &quot;" newline="True"/>
            <output expression="&quot;================================&quot;" newline="True"/>
            <output expression="&quot;Answer 3 math questions. Each correct answer earns 1 point.&quot;" newline="True"/>
            <output expression="&quot;&quot;" newline="True"/>
            <output expression="&quot;Question 1: What is 8 + 5?&quot;" newline="True"/>
            <input variable="answer1"/>
            <if expression="answer1 = 13">
                <then>
                    <output expression="&quot;Correct! +1 point.&quot;" newline="True"/>
                    <assign variable="score" expression="score + 1"/>
                </then>
                <else>
                    <output expression="&quot;Not quite. The correct answer is 13.&quot;" newline="True"/>
                </else>
            </if>
            <output expression="&quot;&quot;" newline="True"/>
            <output expression="&quot;Question 2: What is 7 * 6?&quot;" newline="True"/>
            <input variable="answer2"/>
            <if expression="answer2 = 42">
                <then>
                    <output expression="&quot;Correct! +1 point.&quot;" newline="True"/>
                    <assign variable="score" expression="score + 1"/>
                </then>
                <else>
                    <output expression="&quot;Not quite. The correct answer is 42.&quot;" newline="True"/>
                </else>
            </if>
            <output expression="&quot;&quot;" newline="True"/>
            <output expression="&quot;Question 3: What is 20 - 9?&quot;" newline="True"/>
            <input variable="answer3"/>
            <if expression="answer3 = 11">
                <then>
                    <output expression="&quot;Correct! +1 point.&quot;" newline="True"/>
                    <assign variable="score" expression="score + 1"/>
                </then>
                <else>
                    <output expression="&quot;Not quite. The correct answer is 11.&quot;" newline="True"/>
                </else>
            </if>
            <output expression="&quot;&quot;" newline="True"/>
            <output expression="&quot;========== FINAL SCORE ==========&quot;" newline="True"/>
            <output expression="&quot;Your score is:&quot;" newline="True"/>
            <output expression="score" newline="True"/>
            <if expression="score = 3">
                <then>
                    <output expression="&quot;Perfect score! You are a Brain Battle champion!&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="score = 2">
                        <then>
                            <output expression="&quot;Great job! You know your math.&quot;" newline="True"/>
                        </then>
                        <else>
                            <if expression="score = 1">
                                <then>
                                    <output expression="&quot;Good try! Practice and play again.&quot;" newline="True"/>
                                </then>
                                <else>
                                    <output expression="&quot;Keep practicing. You can improve your score!&quot;" newline="True"/>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;Thanks for playing Brain Battle!&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
